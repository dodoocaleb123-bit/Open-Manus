# Application
OPENMANUS_ENV=development
OPENMANUS_LOG_LEVEL=INFO
OPENMANUS_WORKSPACE_ROOT=./workspace
OPENMANUS_STATE_DB=./workspace/openmanus.sqlite3

# DeepSeek is the only central controller and receives every user request.
# Change to deepseek-r1:1b if that is the model installed locally.
DEEPSEEK_CONTROLLER_MODEL=deepseek-r1:7b
DEEPSEEK_CONTROLLER_BASE_URL=http://localhost:11434/v1
DEEPSEEK_CONTROLLER_API_KEY=ollama

# Specialist roles: keep these assignments distinct.
RESEARCH_LLM_MODEL=qwen2.5:3b
RESEARCH_LLM_BASE_URL=http://localhost:11434/v1
RESEARCH_LLM_API_KEY=ollama

CODER_LLM_MODEL=qwen2.5-coder:7b
CODER_LLM_BASE_URL=http://localhost:11434/v1
CODER_LLM_API_KEY=ollama

VISION_LLM_MODEL=gemma3:4b
VISION_LLM_BASE_URL=http://localhost:11434/v1
VISION_LLM_API_KEY=ollama

CREATIVE_LLM_MODEL=llama3.2:3b
CREATIVE_LLM_BASE_URL=http://localhost:11434/v1
CREATIVE_LLM_API_KEY=ollama

# Llama can write image prompts but cannot generate pixels. Configure a compatible image service for actual images.
OPENMANUS_IMAGE_BASE_URL=
OPENMANUS_IMAGE_API_KEY=
OPENMANUS_IMAGE_MODEL=

# Runtime limits for a 16 GB development laptop.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=1.0
LLM_REQUEST_TIMEOUT=300
AGENT_MAX_STEPS=60
AGENT_MAX_REPAIR_CYCLES=3
AGENT_COMMAND_TIMEOUT=600
HUMAN_REPLY_TIMEOUT=1800
PLATFORM_MAX_CONCURRENT_TASKS=1

# Optional integrations are disabled until their later roadmap phase.
GITHUB_ENABLED=false
GITHUB_TOKEN=
